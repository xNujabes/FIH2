+void UEcosystemSubsystem::SetDefeatEnabled(bool bEnabled)
+{
+	if (bEnabled && !bDefeatEnabled)
+	{
+		// Repart de zéro : rien de ce qui s'est passé pendant la phase guidée ne compte.
+		DefeatTimer = 0.f;
+		ExtinctionTimer = 0.f;
+	}
+	bDefeatEnabled = bEnabled;
+}
+
+void UEcosystemSubsystem::FinishLevel(bool bWon)
+{
+	if (State != EEcosystemState::Playing)
+	{
+		return;
+	}
+	SetState(bWon ? EEcosystemState::Won : EEcosystemState::Lost, EEcosystemEndReason::None);
+	Snapshot.State = State;
+	Snapshot.EndReason = EndReason;
+}
